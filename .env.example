# ==============================================================================
# Environment Configuration Template
# Скопируйте этот файл в .env и заполните реальными значениями.
# ВНИМАНИЕ: Файл .env никогда не должен коммититься в Git!
# ==============================================================================

# [Required] Окружение запуска (development | staging | production)
NODE_ENV=development

# [Required] Сетевой порт сервиса
PORT=3000

# [Required] Базовый URL приложения
APP_URL=http://localhost:3000

# [Required] Подключение к основной базе данных
# PostgreSQL пример: postgresql://postgres:postgres@localhost:5432/myapp_dev
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# [Optional] Секретный ключ для подписи JWT токенов сессий
JWT_SECRET="generate-a-secure-random-string-at-least-32-chars"

# [Optional] Настройки интеграции с LLM / AI провайдерами
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# [Optional] Уровень логирования (error | warn | info | debug)
LOG_LEVEL=info
